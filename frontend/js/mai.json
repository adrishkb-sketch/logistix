    "update_v112_date": "April 30, 2026 | 10:15 AM",
    "update_v112_ver": "v1.1.2 (Linguistic Parity & Universal Access)",
    "update_v112_title": "व्यापक बहुभाषा समर्थन आ सार्वभौमिक पहुँच",
    "update_v112_desc": "आब Logistix प्लेटफॉर्म पर 15 स अधिक क्षेत्रीय भाषा मे पूर्ण समर्थन उपलब्ध अछि।",
    "update_v112_b1": "15+ क्षेत्रीय भाषा: मैथिली, संताली, कश्मीरी सहित अन्य प्रमुख भाषा मे पोर्टल के उपयोग करू।",
    "update_v112_b2": "<strong>स्थानीयकरण:</strong> प्रत्येक डैशबोर्ड आरू बटनक स्थानीय भाषा मे अनुवाद कएल गेल अछि।",
    "update_v112_b3": "<strong>डाइनमिक रजिस्ट्री सिंक:</strong> बिना पेज रिलोड कएने रीयल-टाइम UI अपडेट सुनिश्चित करैत अछि।",
    "update_v112_b4": "<strong>स्थानीय सहायता:</strong> सुरक्षित ड्राइविंगक लेल वॉयस कमांड आब क्षेत्रीय भाषा मे उपलब्ध अछि।",
    "update_v112_impact_desc": "बसी उपयोगकर्ता अब पोर्टल केँ बेसी मुक्त रूप सँ एक्सेस कए सकैत छथि आरू अपन मातृभाषामे आत्मविश्वासक संग काज कए सकैत छथि।",
    "update_v112_i1": "सार्वभौमिक पहुँच: सब क्षेत्रक उपयोगकर्ता आब अपन मातृभाषा मे पोर्टलक उपयोग कए सकैत छथि।",
    "update_v112_i2": "परिचालन समावेशन: ड्राइवर आब स्वतंत्र रूप सँ नेविगेट कए सकैत छथि आरू अपन वॉलेट प्रबंधित कए सकैत छथि।",
    "update_v112_i3": "पारदर्शिता: स्थानीय वित्तीय हेडर लेनदेन मे विश्वास बढ़बैत अछि।",
    "update_v112_i4": "वैश्विक मानक: विश्व स्तरीय तकनीक आरू क्षेत्रीय अनुभवक संगम।",
    "tag_localization": "स्थानीयकरण",
    "tag_accessibility": "Universal Access",
    "tag_multi_lingual": "Multi-Lingual",
    "otp_wait_msg": "Please wait for the timer to finish before requesting again.",
    "otp_sending": "कृपया प्रतीक्षा करू, ओटीपी पठाओल जा रहल अछि...",
    "otp_sent_to_email": "OTP sent to your email.",
    "update_v113_date": "April 30, 2026 | 03:00 PM",
    "update_v113_ver": "v1.1.3 (Security & Onboarding)",
    "update_v113_title": "सुरक्षा सुदृढ़ीकरण आ बेहतर ऑनबोर्डिंग अनुभव",
    "update_v113_desc": "ई अपडेट प्लेटफॉर्म सुरक्षा आ उपयोगकर्ता ऑनबोर्डिंग अनुभव के सुव्यवस्थित करय पर केंद्रित अछि:",
    "update_v113_b1": "सुरक्षित खाता विलोपन: प्रबंधक पासवर्ड आ 6-अंकीय ओटीपी सहित बहु-चरणीय सत्यापन।",
    "update_v113_b2": "ओटीपी प्रवाह अनुकूलन: पूरा प्लेटफॉर्म पर ओटीपी अनुरोध में सिस्टम हैंगिंग समस्या के समाधान कएल गेल।",
    "update_v113_b3": "भूमिका-आधारित सूचना: पंजीकरण, खाता विलोपन आ ट्रैकिंग क लेल उद्देश्य-आधारित ईमेल टेम्पलेट्स पेश कएल गेल।",
