    "update_v112_date": "April 30, 2026 | 10:15 AM",
    "update_v112_ver": "v1.1.2 (Linguistic Parity)",
    "update_v112_title": "ಸಮಗ್ರ ಬಹು-ಭಾಷಾ ಬೆಂಬಲ ಮತ್ತು ಸಾರ್ವತ್ರಿಕ ಪ್ರವೇಶ",
    "update_v112_desc": "ನಾವು ಇಡೀ ಲಾಜಿಸ್ಟಿಕ್ಸ್ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ನಲ್ಲಿ ಪೂರ್ಣ ಭಾಷಾ ಸಮಾನತೆಯನ್ನು ಸಾಧಿಸಿದ್ದೇವೆ.",
    "update_v112_b1": "<strong>15+ ಪ್ರಾದೇಶಿಕ ಭಾಷೆಗಳು:</strong> ಹಿಂದಿ, ಬಂಗಾಳಿ, ಗುಜರಾತಿ, ತೆಲುಗು, ತಮಿಳು, ಮರಾಠಿ, ಕನ್ನಡ, ಮಲಯಾಳಂ, ಒಡಿಯಾ, ಪಂಜಾಬಿ, ಅಸ್ಸಾಮಿ, ಮೈಥಿಲಿ, ಸಂತಾಲಿ ಮತ್ತು ಕಾಶ್ಮೀರಿ ಭಾಷೆಗಳಿಗೆ ಪೂರ್ಣ ಬೆಂಬಲ.",
    "update_v112_b2": "<strong>ಎಂಡ್-ಟು-ಎಂಡ್ ಸ್ಥಳೀಕರಣ:</strong> ಪ್ರತಿಯೊಂದು ಡ್ಯಾಶ್‌ಬೋರ್ಡ್, ಟೇಬಲ್ ಹೆಡರ್ ಮತ್ತು ಬಟನ್‌ಗಳನ್ನು ಸ್ಥಳೀಕರಿಸಲಾಗಿದೆ.",
    "update_v112_b3": "<strong>ಡೈನಾಮಿಕ್ ರೆಜಿಸ್ಟ್ರಿ ಸಿಂಕ್:</strong> ಪುಟ ಮರುಲೋಡ್ ಮಾಡದೆಯೇ ನೈಜ-ಸಮಯದ UI ನವೀಕರಣಗಳನ್ನು ಖಚಿತಪಡಿಸುವ ಎಂಜಿನ್.",
    "update_v112_b4": "<strong>ಸ್ಥಳೀಯ ಸಹಾಯ ಮತ್ತು ಧ್ವನಿ:</strong> ಸುರಕ್ಷಿತ ಚಾಲನೆಗಾಗಿ ಧ್ವನಿ ಆಜ್ಞೆಗಳು ಈಗ ಪ್ರಾದೇಶಿಕ ಭಾಷೆಗಳಲ್ಲಿ ಲಭ್ಯವಿದೆ.",
    "update_v112_impact_desc": "ಹೆಚ್ಚಿನ ಬಳಕೆದಾರರು ಈಗ ಪೋರ್ಟಲ್ ಅನ್ನು ಹೆಚ್ಚು ಮುಕ್ತವಾಗಿ ಪ್ರವೇಶಿಸಬಹುದು ಮತ್ತು ಅವರ ಮಾತೃಭಾಷೆಯಲ್ಲಿ ವಿಶ್ವಾಸದಿಂದ ಕೆಲಸ ಮಾಡಬಹುದು.",
    "update_v112_i1": "ಸಾರ್ವತ್ರಿಕ ಪ್ರವೇಶ: ಎಲ್ಲಾ ಪ್ರದೇಶಗಳ ಬಳಕೆದಾರರು ಈಗ ಪೋರ್ಟಲ್ ಅನ್ನು ಅವರ ಮಾತೃಭಾಷೆಯಲ್ಲಿ ಮುಕ್ತವಾಗಿ ಪ್ರವೇಶಿಸಬಹುದು.",
    "update_v112_i2": "ಕಾರ್ಯಾಚರಣೆಯ ಒಳಗೊಳ್ಳುವಿಕೆ: ಚಾಲಕರು ಈಗ ಸ್ವತಂತ್ರವಾಗಿ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಬಹುದು ಮತ್ತು ಅವರ ವ್ಯಾಲೆಟ್ ನಿರ್ವಹಿಸಬಹುದು.",
    "update_v112_i3": "ಪಾರದರ್ಶಕತೆ: ಸ್ಥಳೀಯ ಹಣಕಾಸು ಹೆಡರ್‌ಗಳು ವ್ಯವಹಾರಗಳಲ್ಲಿ ನಂಬಿಕೆಯನ್ನು ಹೆಚ್ಚಿಸುತ್ತವೆ.",
    "update_v112_i4": "ಜಾಗತಿಕ ಮಾನದಂಡಗಳು, ಸ್ಥಳೀಯ ಅನುಭವ: ವಿಶ್ವದರ್ಜೆಯ ತಂತ್ರಜ್ಞಾನದೊಂದಿಗೆ ಪ್ರಾದೇಶಿಕ ಅನುಭವದ ಸಮ್ಮಿಲನ.",
    "tag_localization": "ಸ್ಥಳೀಕರಣ",
    "tag_accessibility": "Universal Access",
    "tag_multi_lingual": "Multi-Lingual",
    "otp_wait_msg": "Please wait for the timer to finish before requesting again.",
    "otp_sending": "ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ, OTP ಕಳುಹಿಸಲಾಗುತ್ತಿದೆ...",
    "otp_sent_to_email": "OTP sent to your email.",
    "update_v113_title": "ಡ್ರೋನ್ ಫ್ಲೀಟ್ ಏಕೀಕರಣ ಮತ್ತು ಭದ್ರತಾ ಬಲಪಡಿಸುವಿಕೆ",
    "update_v113_date": "April 30, 2026 | 05:00 PM",
    "update_v113_ver": "v1.1.3 (Drones & Security)",
    "update_v113_desc": "ಈ ಅಪ್‌ಡೇಟ್ ಸ್ವಾಯತ್ತ ಡ್ರೋನ್ ಫ್ಲೀಟ್‌ಗಳನ್ನು ಪ್ರಾಥಮಿಕ ಸಾರಿಗೆ ವಿಧಾನವಾಗಿ ಪರಿಚಯಿಸುತ್ತದೆ ಮತ್ತು ಖಾತೆಯ ಭದ್ರತೆಯನ್ನು ಬಲಪಡಿಸುತ್ತದೆ:",
    "update_v113_b1": "ಡ್ರೋನ್ ಫ್ಲೀಟ್ ಮ್ಯಾನೇಜ್‌ಮೆಂಟ್: ಡ್ರೋನ್‌ಗಳು ಈಗ ಸಮರ್ಪಿತ ನೋಂದಣಿ, ಪರವಾನಗಿ ಟ್ರ್ಯಾಕಿಂಗ್ ಮತ್ತು ಬಲ್ಕ್ ಅಪ್‌ಲೋಡ್ ಬೆಂಬಲದೊಂದಿಗೆ ಪ್ರಮುಖ ಸಾರಿಗೆ ವಿಧಾನವಾಗಿದೆ.",
    "update_v113_b2": "ಸ್ಮಾರ್ಟ್ ಡ್ರೋನ್ ಸಹಾಯಕ: ಮಾರ್ಗದರ್ಶಿತ ಹಂತ ಹಂತದ ಚಾಟ್ ಇಂಟರ್ಫೇಸ್ ಮೂಲಕ ಡ್ರೋನ್‌ಗಳನ್ನು ಆನ್‌ಬೋರ್ಡ್ ಮಾಡಿ.",
    "update_v113_b3": "ಸುಧಾರಿತ OTP ವಿಶ್ವಾಸಾರ್ಹತೆ: ಸೈನ್ ಅಪ್, ಖಾತೆ ಅಳಿಸುವಿಕೆ ಮತ್ತು ಟ್ರ್ಯಾಕಿಂಗ್ ಫ್ಲೋಗಳಲ್ಲಿ OTP ವಿನಂತಿಗಳಲ್ಲಿನ ಸಮಸ್ಯೆಗಳನ್ನು ಪರಿಹರಿಸಲಾಗಿದೆ.",
    "update_v113_b4": "ಸುರಕ್ಷಿತ ಖಾತೆ ಅಳಿಸುವಿಕೆ: ಗರಿಷ್ಠ ಭದ್ರತೆಗಾಗಿ ಖಾತೆ ಅಳಿಸಲು ಈಗ ಮ್ಯಾನೇಜರ್ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು OTP ಯೊಂದಿಗೆ ಬಹು-ಅಂಶದ ಪರಿಶೀಲನೆ ಅಗತ್ಯವಿದೆ.",
    "update_v113_impact_desc": "ಬಳಕೆದಾರರು ಹೆಚ್ಚು ಬಹುಮುಖ ಫ್ಲೀಟ್ ಮತ್ತು ಹೆಚ್ಚು ವಿಶ್ವಾಸಾರ್ಹ ದೃಢೀಕರಣ ಅನುಭವದಿಂದ ಪ್ರಯೋಜನ ಪಡೆಯುತ್ತಾರೆ:",
    "update_v113_i1": "ಬಹುಮುಖ ಲಾಜಿಸ್ಟಿಕ್ಸ್: ಏಕೀಕೃತ 'Drivers & Fleet' ಡ್ಯಾಶ್‌ಬೋರ್ಡ್‌ನಿಂದ ಭೂಮಿಯ ಮತ್ತು ವೈಮಾನಿಕ ಆಸ್ತಿಗಳನ್ನು ಮನಬಂದಂತೆ ನಿರ್ವಹಿಸಿ.",
    "update_v113_i2": "ಪ್ರಯಾಸವಿಲ್ಲದ ಆನ್‌ಬೋರ್ಡಿಂಗ್: ಸ್ಮಾರ್ಟ್ ಸಹಾಯಕರು ಸಂಕೀರ್ಣ ನೋಂದಣಿಗಳ ಮೂಲಕ ನಿಮಗೆ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತಾರೆ, ಡೇಟಾ ನಮೂದು ದೋಷಗಳನ್ನು ನಿವಾರಿಸುತ್ತಾರೆ.",
    "update_v113_i3": "ವಿಶ್ವಾಸಾರ್ಹ ದೃಢೀಕರಣ: ಸ್ಥಳೀಕರಿಸಿದ OTP ಸಂದೇಶಗಳು ಮತ್ತು ಸುಧಾರಿತ ಬ್ಯಾಕೆಂಡ್ ಸಿಂಕ್ರೊನೈಸೇಶನ್ ಪರಿಶೀಲನೆಯ ಸಮಯದಲ್ಲಿ ನೀವು ಎಂದಿಗೂ ಸಿಲುಕಿಕೊಳ್ಳದಂತೆ ಖಚಿತಪಡಿಸುತ್ತದೆ.",
