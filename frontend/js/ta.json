    "voice_instr_drivers": "சரிபார்க்கப்பட்ட கடற்படை மற்றும் இயக்கி பதிவேட்டைத் திறக்கவும்",
    "voice_instr_fuel_oracle": "பாரத்-எரிபொருள் மற்றும் மாநிலங்களுக்கு இடையேயான கட்டண ஆரக்கிளை அணுகவும்",
    "voice_instr_infrastructure": "உங்கள் பிராந்திய கிடங்குகள் மற்றும் உள்கட்டமைப்பை நிர்வகிக்கவும்",
    "voice_instr_leaderboard": "டிரைவர் மற்றும் வாகன செயல்திறன் லீடர்போர்டுகளைத் திறக்கவும்",
    "voice_instr_leaves": "மையப்படுத்தப்பட்ட இலைகள் மற்றும் பராமரிப்பு பதிவேட்டைப் பார்க்கவும்",
    "voice_instr_messages": "கடற்படைப் பணியாளர்களுடன் அரட்டையடிக்க செய்திகள் பேனலைத் திறக்கவும்",
    "voice_instr_oracle": "மூலோபாய திட்டமிடல் டிஜிட்டல் இரட்டை ஆரக்கிளை அணுகவும்",
    "voice_instr_receivers": "பெறுதல் அடைவு மற்றும் நிலைப் பலகையைத் திறக்கவும்",
    "voice_instr_resilience": "நெட்வொர்க் கேஸ்கேட் சிமுலேஷன்ஸ் மற்றும் ஹெல்த் டயக்னாஸ்டிக்ஸ் ஆகியவற்றை இயக்கவும்",
    "voice_instr_settings": "தரவுத்தள அமைப்புகள் மற்றும் கணினி அளவுருக்களை நிர்வகிக்கவும்",
    "voice_instr_strategy": "தற்போதைய செயல்பாட்டு உத்தி செயல்படுத்தலைக் கண்காணிக்கவும்",
    "voice_instr_sync_watch": "அணியக்கூடிய ஸ்மார்ட்வாட்சிலிருந்து சுகாதார அளவீடுகளை ஒத்திசைக்கவும்",
    "voice_instr_toggle_duty": "செயலில் மற்றும் கடமைக்கு இடையில் உங்கள் கடமை நிலையை மாற்றவும்",
    "voice_instr_verifications": "கைமுறை மதிப்புரைகளுக்கு ML சரிபார்ப்பு மையத்தைத் திறக்கவும்",
    "voice_instr_weather": "நிகழ்நேர வானிலை மற்றும் வழி நுண்ணறிவு வரைபடத்தைத் திறக்கவும்"
}